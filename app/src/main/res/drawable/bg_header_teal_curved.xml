    android:width="360dp"
    android:height="208dp"
    android:viewportWidth="360"
    android:viewportHeight="208">

    <path
        android:fillColor="@color/teal_primary"
        android:pathData="M0,0 L0,193.5 C12,194.5 24,196 36,196.2 C58,196.8 80,194 100,193.2 C116,192.6 136,193 152,196.6 C166,199.8 178,204.8 194,205.8 C208,206.6 224,203.2 248,202.4 C272,201.8 296,205 320,203.6 C336,202.6 348,200 360,197 L360,0 Z" />

</vector>
