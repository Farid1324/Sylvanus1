<?xml version="1.0" encoding="utf-8"?>
<!--
    Main-crop mark: a coffee sprig — a diagonal branch with a leaf on each
    side and a pair of cherries at the tip. Outlined at the same 1.7 stroke
    as the other field icons so the column of leading icons reads as one set.
    @drawable/ic_leaf stays the filled green leaf used elsewhere in the flow.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Branch, plus the two short stalks carrying the cherries -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineCap="round"
        android:pathData="M5.5,21 C8.5,16.5 11.5,12.5 15,9 M15,9 L16.8,7.1 M15,9 L13.2,6.9" />

    <!-- Leaf below the branch -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineJoin="round"
        android:pathData="M10.3,15.2 C7.6,17.2 4.1,16.5 2.6,13.4 C5.6,11.6 9,12.3 10.3,15.2 Z" />

    <!-- Leaf above the branch -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.7"
        android:strokeLineJoin="round"
        android:pathData="M12.6,12.2 C13.8,9.2 17.1,7.4 20.4,8.4 C19.4,11.7 15.8,13.4 12.6,12.2 Z" />

    <!-- Cherries -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.7"
        android:pathData="M18,5.1 m-2.5,0 a2.5,2.5 0,1 1,5 0 a2.5,2.5 0,1 1,-5 0" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="1.7"
        android:pathData="M11.6,4.9 m-2.1,0 a2.1,2.1 0,1 1,4.2 0 a2.1,2.1 0,1 1,-4.2 0" />

</vector>
