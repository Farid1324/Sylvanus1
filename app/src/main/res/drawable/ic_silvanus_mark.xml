<?xml version="1.0" encoding="utf-8"?>
<!--
    TANIT brand mark — traced from the design mockup.

    Every coordinate below was measured off the mockup artwork pixel-by-pixel
    and mapped onto a 100 x 100 viewport (disc centred 50,50, r 50):
      ring      teal outline, 2.2 units (defines the disc on the cream
                masthead; on teal the cream sky defines it instead)
      sun       cx 50.2  cy 31.4  r 14.6
      ridge     29 sampled points, peaks at x 22.7 and x 75.8, valley at x 47.7
      waterline flat at y 70.9
      ripples   y 76.8 / 85.0 / 93.0, rounded caps

    Colours are the brand values in colors.xml, sampled from tanit.solutions.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="144dp"
    android:height="144dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Sky -->
    <path
        android:fillColor="@color/brand_cream"
        android:pathData="M50,1.1 C77,1.1 98.9,23 98.9,50 C98.9,77 77,98.9 50,98.9 C23,98.9 1.1,77 1.1,50 C1.1,23 23,1.1 50,1.1 Z" />

    <group>
        <clip-path android:pathData="M50,1.1 C77,1.1 98.9,23 98.9,50 C98.9,77 77,98.9 50,98.9 C23,98.9 1.1,77 1.1,50 C1.1,23 23,1.1 50,1.1 Z" />

        <!-- Sun -->
        <path
            android:fillColor="@color/brand_orange"
            android:pathData="M50.2,16.8 A14.6,14.6 0 1,1 50.1,16.8 Z" />

        <!-- Ridgeline -->
        <path
            android:fillColor="@color/brand_teal"
            android:pathData="M-2,45 L7,44.3 L10.2,43.2 L13.3,44.3 L16.4,43.2 L19.5,39.3 L22.7,37.7 L25.8,39.3 L28.9,43.6 L32,45.9 L35.2,49.8 L38.3,52.9 L41.4,55.3 L44.5,57.6 L47.7,59.2 L50.8,58.8 L53.9,58 L57,57.2 L60.2,53.7 L63.3,52.1 L66.4,49.4 L69.5,46.3 L72.7,42.8 L75.8,41.2 L78.9,42 L82,44.7 L85.2,47.5 L88.3,50.6 L91.4,52.5 L94.5,53.3 L102,54 L102,102 L-2,102 Z" />

        <!-- Water -->
        <path
            android:fillColor="@color/brand_water"
            android:pathData="M-2,70.9 L102,70.9 L102,102 L-2,102 Z" />

        <!-- Ripples -->
        <path
            android:fillColor="@color/brand_cream"
            android:pathData="M18.75,76.8 L42.55,76.8 A1.75,1.75 0 0,1 42.55,80.3 L18.75,80.3 A1.75,1.75 0 0,1 18.75,76.8 Z
                              M26.95,85.0 L69.15,85.0 A1.75,1.75 0 0,1 69.15,88.5 L26.95,88.5 A1.75,1.75 0 0,1 26.95,85.0 Z
                              M34.75,93.0 L51.75,93.0 A1.5,1.5 0 0,1 51.75,96.0 L34.75,96.0 A1.5,1.5 0 0,1 34.75,93.0 Z" />

    </group>

    <!-- Outline ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="@color/brand_teal"
        android:strokeWidth="2.2"
        android:pathData="M50,1.1 C77,1.1 98.9,23 98.9,50 C98.9,77 77,98.9 50,98.9 C23,98.9 1.1,77 1.1,50 C1.1,23 23,1.1 50,1.1 Z" />

</vector>
