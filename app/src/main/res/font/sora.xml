<?xml version="1.0" encoding="utf-8"?>
<!--
    Sora — the TANIT brand typeface (tanit.solutions).
    Applied app-wide via android:fontFamily on Theme.Silvius12, so every
    TextView/Button picks it up; textStyle="bold" resolves to the 700 face.
    Use @font/sora_extrabold explicitly for the wordmark and screen titles.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <font android:font="@font/sora_regular" android:fontStyle="normal" android:fontWeight="400"
        app:font="@font/sora_regular" app:fontStyle="normal" app:fontWeight="400" />

    <font android:font="@font/sora_medium" android:fontStyle="normal" android:fontWeight="500"
        app:font="@font/sora_medium" app:fontStyle="normal" app:fontWeight="500" />

    <font android:font="@font/sora_semibold" android:fontStyle="normal" android:fontWeight="600"
        app:font="@font/sora_semibold" app:fontStyle="normal" app:fontWeight="600" />

    <font android:font="@font/sora_bold" android:fontStyle="normal" android:fontWeight="700"
        app:font="@font/sora_bold" app:fontStyle="normal" app:fontWeight="700" />

    <font android:font="@font/sora_extrabold" android:fontStyle="normal" android:fontWeight="800"
        app:font="@font/sora_extrabold" app:fontStyle="normal" app:fontWeight="800" />

</font-family>
